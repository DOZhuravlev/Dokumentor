.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# -----------------------------
# Xcode / Derived
# -----------------------------
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.xccheckout
*.moved-aside
*.xcscmblueprint

# Мы НЕ коммитим сгенерированные Xcode-проекты/воркспейсы Tuist
*.xcodeproj
*.xcworkspace

# -----------------------------
# Tuist
# -----------------------------
.tuist-bin/
.graph/
# Tuist генерит проект — не коммитим артефакты генерации
# Но lock-файл пакетов Tuist оставляем в репо:
!Tuist/Package.resolved

# -----------------------------
# Swift Package Manager
# -----------------------------
.swiftpm/
.build/
# В некоторых конфигурациях SPM кладёт резолв рядом — если появится локально:
Package.pins
# Общий lock обычно в Tuist/Package.resolved (его не игнорим см. выше)

# -----------------------------
# CocoaPods (если не используете — можно убрать)
# -----------------------------
Pods/
*.podspec.json

# -----------------------------
# Carthage (если не используете — можно убрать)
# -----------------------------
Carthage/Build/
Carthage/Checkouts/

